  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D E:\Trae\hermes-gadget-sdk\firmware\esp32\build-cyd\esp-idf\nvs_flash && C:\Espressif\tools\cmake\4.0.3\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

