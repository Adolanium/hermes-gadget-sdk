# Waveshare ESP32-S3-Touch-AMOLED-2.16 development board (SKU 33969): ESP32-S3R8
# (8 MB octal PSRAM), 16 MB flash, square 480x480 CO5300 AMOLED, CST9220 touch,
# ES8311 + ES7210 codecs, AXP2101 PMIC (battery header), PWR, GPIO18 key, BOOT.
# Pins: docs/hardware.md#esp32-s3-touch-amoled-216
CONFIG_IDF_TARGET="esp32s3"
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# The USB-C port is the S3's own USB Serial/JTAG; the console must live on USB.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HG_BOARD_AMOLED_216=y
