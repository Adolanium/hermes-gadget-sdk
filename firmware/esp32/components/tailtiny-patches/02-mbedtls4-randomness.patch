diff -ruN a/tailtiny/include/tailtiny_internal.h b/tailtiny/include/tailtiny_internal.h
--- a/tailtiny/include/tailtiny_internal.h	2026-10-29 15:04:27.000000000 +0000
+++ b/tailtiny/include/tailtiny_internal.h	2026-10-29 15:04:58.289190956 +0000
@@ -24,8 +24,12 @@
 #include "freertos/event_groups.h"
 #include "freertos/semphr.h"
 #include "mbedtls/ssl.h"
+/* Hermes gadget patch: Mbed TLS 4 (ESP-IDF 6) draws TLS randomness from PSA
+ * and made the entropy/CTR-DRBG modules private. */
+#if MBEDTLS_VERSION_MAJOR < 4
 #include "mbedtls/entropy.h"
 #include "mbedtls/ctr_drbg.h"
+#endif
 #include "esp_heap_caps.h"
 #include "lwip/tcpip.h"
 #include "lwip/priv/tcpip_priv.h"   /* tcpip_api_call() */
@@ -355,8 +359,10 @@
     int sockfd;                     /* Raw TCP socket */
     mbedtls_ssl_context ssl;        /* TLS context (owned exclusively by DERP I/O task) */
     mbedtls_ssl_config ssl_conf;
+#if MBEDTLS_VERSION_MAJOR < 4
     mbedtls_entropy_context entropy;
     mbedtls_ctr_drbg_context ctr_drbg;
+#endif
     bool connected;
     uint64_t last_recv_ms;          /* For keepalive watchdog */
 } ml_derp_conn_t;
diff -ruN a/tailtiny/src/ml_derp.c b/tailtiny/src/ml_derp.c
--- a/tailtiny/src/ml_derp.c	2026-10-29 15:04:27.000000000 +0000
+++ b/tailtiny/src/ml_derp.c	2026-10-29 15:04:58.289425247 +0000
@@ -785,8 +785,10 @@
 static void derp_connect_abort(tailtiny_t *ml, int sock) {
     mbedtls_ssl_free(&ml->derp.ssl);
     mbedtls_ssl_config_free(&ml->derp.ssl_conf);
+#if MBEDTLS_VERSION_MAJOR < 4
     mbedtls_ctr_drbg_free(&ml->derp.ctr_drbg);
     mbedtls_entropy_free(&ml->derp.entropy);
+#endif
     ml_close_sock(sock);
     ml->derp.sockfd = -1;
 }
@@ -864,11 +866,15 @@
     /* TLS setup */
     mbedtls_ssl_init(&ml->derp.ssl);
     mbedtls_ssl_config_init(&ml->derp.ssl_conf);
+#if MBEDTLS_VERSION_MAJOR < 4
     mbedtls_entropy_init(&ml->derp.entropy);
     mbedtls_ctr_drbg_init(&ml->derp.ctr_drbg);
 
     int setup_ret = mbedtls_ctr_drbg_seed(&ml->derp.ctr_drbg, mbedtls_entropy_func,
                                           &ml->derp.entropy, NULL, 0);
+#else
+    int setup_ret = 0;
+#endif
     if (setup_ret == 0) {
         setup_ret = mbedtls_ssl_config_defaults(&ml->derp.ssl_conf,
                                                 MBEDTLS_SSL_IS_CLIENT,
@@ -881,7 +887,9 @@
         return ESP_FAIL;
     }
     mbedtls_ssl_conf_authmode(&ml->derp.ssl_conf, MBEDTLS_SSL_VERIFY_NONE);
+#if MBEDTLS_VERSION_MAJOR < 4
     mbedtls_ssl_conf_rng(&ml->derp.ssl_conf, mbedtls_ctr_drbg_random, &ml->derp.ctr_drbg);
+#endif
     mbedtls_ssl_conf_read_timeout(&ml->derp.ssl_conf, DERP_CONNECT_TIMEOUT_MS);
 
     setup_ret = mbedtls_ssl_setup(&ml->derp.ssl, &ml->derp.ssl_conf);
@@ -1185,8 +1193,10 @@
         mbedtls_ssl_close_notify(&ml->derp.ssl);
         mbedtls_ssl_free(&ml->derp.ssl);
         mbedtls_ssl_config_free(&ml->derp.ssl_conf);
+#if MBEDTLS_VERSION_MAJOR < 4
         mbedtls_ctr_drbg_free(&ml->derp.ctr_drbg);
         mbedtls_entropy_free(&ml->derp.entropy);
+#endif
         ml_close_sock(ml->derp.sockfd);
         ml->derp.sockfd = -1;
     }
