# Elecrow CrowPanel Advanced 10.1-inch ESP32-P4 (V1.1).
# Stacked over firmware/esp32/sdkconfig.defaults.
#
# ESP32-P4 has no on-chip Wi-Fi: connectivity runs on the ESP32-C6 companion
# over 4-bit SDIO via esp_hosted + esp_wifi_remote. The application uses the
# normal esp_wifi_* API unchanged. NOTE: esp_wifi_remote's Kconfig resolves
# `orsource ./idf_v$ESP_IDF_VERSION/...`, so ESP_IDF_VERSION (major.minor) must
# be set before idf.py configure — firmware/esp32/CMakeLists.txt derives it from
# version.txt when the environment lacks it (see the esp32-p4-hosted-wifi skill).
CONFIG_IDF_TARGET="esp32p4"
# This unit is an ESP32-P4 rev v1.3; restrict the image to pre-v3 silicon so the
# bootloader/esptool revision check passes (matches the vendor's P4 defaults).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP32P4_REV_MAX_FULL=199

# 16 MB flash, QIO, matching the module. FLASHSIZE is a choice; the base
# defaults pick 4MB, so turn that off explicitly.
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_STR=y

# 32 MB PSRAM. ESP32-P4 uses the HEX PSRAM mode (SPIRAM_MODE_HEX), not OCT.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set

# Wi-Fi via the ESP32-C6 coprocessor over SDIO.
# ESP_HOST_WIFI_ENABLED and ESP_WIFI_REMOTE_ENABLED are mutually exclusive.
# CONFIG_ESP_HOST_WIFI_ENABLED is not set
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_PRIV_SDIO_OPTION=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
# CONFIG_ESP_HOSTED_SPI_HOST_INTERFACE is not set
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
# CONFIG_ESP_HOSTED_SDIO_1_BIT_BUS is not set
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=17
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=14
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=32
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y

CONFIG_HG_BOARD_CROWPANEL_P4_101=y
