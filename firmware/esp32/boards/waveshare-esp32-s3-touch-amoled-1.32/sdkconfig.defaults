# Waveshare ESP32-S3-Touch-AMOLED-1.32: ESP32-S3-PICO-1-N8R8 (8 MB flash,
# 8 MB octal PSRAM), round 466x466 CO5300, CST820 touch, one ES8311.
# Pins: docs/hardware.md#waveshare-esp32-s3-touch-amoled-132
CONFIG_IDF_TARGET="esp32s3"
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# The 434 KB framebuffer and audio buffers go to PSRAM.
CONFIG_SPIRAM_USE_MALLOC=y
# If PSRAM ever fails to start, boot anyway so the log and `diag` can say so.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# The USB-C port is the S3's own USB Serial/JTAG; the console must live on USB.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HG_BOARD_WS_ESP32S3_TOUCH_AMOLED_132=y

# TCP windows for links with a long round trip (a phone hotspot): 5,760 B capped
# a connection near 33 KB/s at 175 ms, below 24 kHz audio's 48 KB/s.
# Wi-Fi and lwIP buffers in PSRAM first, internal RAM when the module has none.
# docs/porting.md#network-buffers
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
