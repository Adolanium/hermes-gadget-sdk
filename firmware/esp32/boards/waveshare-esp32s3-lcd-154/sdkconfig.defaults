# Waveshare ESP32-S3-LCD-1.54 (-EN): ESP32-S3R8 (8 MB octal PSRAM), 16 MB flash,
# 1.54" 240x240 ST7789 SPI display, ES8311 + ES7210 codecs, NS4150B amplifier.
# Pins: docs/hardware.md#waveshare-esp32-s3-lcd-154
CONFIG_IDF_TARGET="esp32s3"
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# The 115 KB framebuffer and audio buffers go to PSRAM.
CONFIG_SPIRAM_USE_MALLOC=y
# If PSRAM ever fails to start, boot anyway so the log and `diag` can say so.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# The Type-C port is the S3's own USB Serial/JTAG and the console must live there:
# a secondary console is output-only, so commands typed over USB would never
# arrive. UART0 only reaches the header pads on this board.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HG_BOARD_WS_ESP32S3_LCD_154=y
# Battery life: scale the CPU down to 80 MHz when idle (see app_main).
CONFIG_PM_ENABLE=y
# Light sleep while dozing (on battery, screen off, idle; see EspSystem::enable_doze).
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# And never while a USB host is connected: the serial console and JTAG stop
# working under light sleep. The app's on-battery check is the main guard.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# Wi-Fi wakes for each beacon from light sleep on the slow clock's timing; the
# 17.5 MHz / 256 oscillator drifts less than the default 150 kHz RC.
# CONFIG_RTC_CLK_SRC_INT_RC is not set
CONFIG_RTC_CLK_SRC_INT_8MD256=y
# Counts light sleep for the log line that ends each doze (EspSystem::set_dozing).
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y

# TCP windows for links with a long round trip (a phone hotspot): 5,760 B capped
# a connection near 33 KB/s at 175 ms, below 24 kHz audio's 48 KB/s.
# Wi-Fi and lwIP buffers in PSRAM first, internal RAM when the module has none.
# docs/porting.md#network-buffers
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
