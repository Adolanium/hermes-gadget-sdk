# Waveshare ESP32-S3-Touch-AMOLED-1.75: ESP32-S3R8 (8 MB octal PSRAM), 16 MB flash,
# round 466x466 CO5300 AMOLED, CST9217 touch, ES8311 + ES7210 codecs, AXP2101, TCA9554.
# Pins: docs/hardware.md#esp32-s3-touch-amoled-175
CONFIG_IDF_TARGET="esp32s3"
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# The 434 KB framebuffer and audio buffers go to PSRAM.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# The USB-C port is the S3's own USB Serial/JTAG, and UART0 only reaches the header.
# The console must live on USB: a secondary console is output-only, so commands
# typed over USB would never arrive.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HG_BOARD_AMOLED_175=y
