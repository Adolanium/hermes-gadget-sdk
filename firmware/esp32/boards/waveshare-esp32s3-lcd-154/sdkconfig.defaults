# Waveshare ESP32-S3-LCD-1.54 (-EN): ESP32-S3R8 (8 MB octal PSRAM), 16 MB flash,
# 1.54" 240x240 ST7789 SPI display, ES8311 + ES7210 codecs, NS4150B amplifier.
# Pins: docs/hardware.md#waveshare-esp32-s3-lcd-154
CONFIG_IDF_TARGET="esp32s3"
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# The 115 KB framebuffer and audio buffers go to PSRAM.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# The Type-C port is the S3's own USB Serial/JTAG and the console must live there:
# a secondary console is output-only, so commands typed over USB would never
# arrive. UART0 only reaches the header pads on this board.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HG_BOARD_WS_ESP32S3_LCD_154=y
