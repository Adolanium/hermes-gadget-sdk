build CMakeFiles/encrypted-app-flash | ${cmake_ninja_workdir}CMakeFiles/encrypted-app-flash: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D E:\Trae\hermes-gadget-sdk\firmware\esp32\build-cyd && C:\Espressif\tools\cmake\4.0.3\bin\cmake.exe -E echo "Error: The target encrypted-app-flash requires" && C:\Espressif\tools\cmake\4.0.3\bin\cmake.exe -E echo "CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT to be enabled." && C:\Espressif\tools\cmake\4.0.3\bin\cmake.exe -E env "FAIL_MESSAGE=Failed executing target (see errors on lines above)" C:/Espressif/tools/cmake/4.0.3/bin/cmake.exe -P C:/esp/v6.1/esp-idf/tools/cmake/scripts/fail.cmake"


