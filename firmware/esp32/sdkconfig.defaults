# Defaults for every board. Board-specific overrides live in boards/<name>/sdkconfig.defaults
# and are stacked with:  idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/<name>/sdkconfig.defaults" build

# Two 1.9 MB app slots for over-the-air updates (partitions.csv). A new firmware
# boots on probation: it must reach Hermes within 5 minutes or the bootloader
# goes back to the previous one (port_ota.cpp).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# The core runs on the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Lets the console's `diag` report every task's unused stack.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# C++: the core uses std::string/std::vector/std::function, no exceptions or RTTI.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Public CA bundle for wss:// servers behind a real certificate.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# Trust a chain as soon as one of its certificates is issued by a bundled root.
# Without it only the issuer of the last certificate sent is looked up: Cloudflare
# sends GTS Root R4 cross-signed by GlobalSign Root CA, which the bundle no longer
# has, so its tunnels failed although GTS Root R4 itself is bundled. Costs about
# 700 bytes of heap, by ESP-IDF's estimate.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# Rejoining Wi-Fi: DHCP asks for the last address straight away (a DHCPREQUEST
# without the discovery round) and lwIP keeps that address in NVS for the next boot.
# The port also skips the channel scan for the access point that last worked
# (drivers/wifi_fast.hpp).
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y

# Keep logs readable on the serial console that also carries the gadget console.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
