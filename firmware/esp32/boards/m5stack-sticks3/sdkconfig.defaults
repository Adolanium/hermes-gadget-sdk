# M5Stack StickS3: ESP32-S3-PICO-1-N8R8 (8 MB flash, 8 MB octal PSRAM), 1.14"
# 135x240 ST7789P3, one ES8311 codec, M5PM1 power manager.
# Pins: docs/hardware.md#m5stack-sticks3
CONFIG_IDF_TARGET="esp32s3"
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# The USB-C port is the S3's own USB Serial/JTAG; the console must live on USB.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HG_BOARD_STICKS3=y
