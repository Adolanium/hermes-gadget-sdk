# LilyGO T-Display-S3: ESP32-S3R8 (8 MB octal PSRAM), 16 MB flash, 1.9" 170x320
# ST7789 on an 8-bit i80 parallel bus, BOOT and Button2, battery on GPIO 4.
# No microphone, speaker or codec on this board.
# Pins: docs/hardware.md#lilygo-t-display-s3
CONFIG_IDF_TARGET="esp32s3"
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# The 108 KB framebuffer and audio buffers go to PSRAM.
CONFIG_SPIRAM_USE_MALLOC=y
# If PSRAM ever fails to start, boot anyway so the log and `diag` can say so.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# The USB-C port is the S3's own USB Serial/JTAG, and UART0 only reaches the header.
# The console must live on USB: a secondary console is output-only, so commands
# typed over USB would never arrive.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HG_BOARD_T_DISPLAY_S3=y